# Copie este arquivo para .env.local e preencha com suas chaves reais.
# .env.local nunca deve ser commitado no git (já está no .gitignore).

# Chave de acesso (Access Token) da sua conta Mercado Pago.
# Onde pegar: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=

# Token da API do Melhor Envio, usado para calcular frete de verdade.
# Onde pegar: https://melhorenvio.com.br (crie uma conta e gere um token de API)
MELHOR_ENVIO_TOKEN=

# ID de medição do Google Analytics (GA4), formato G-XXXXXXXXXX.
# Onde pegar: https://analytics.google.com > Admin > Fluxos de dados > seu site
# Precisa do prefixo NEXT_PUBLIC_ porque roda no navegador do cliente.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ID do Pixel da Meta (Facebook/Instagram Ads), só números.
# Onde pegar: https://business.facebook.com/events_manager > seu pixel > Configurações
# Precisa do prefixo NEXT_PUBLIC_ porque roda no navegador do cliente.
NEXT_PUBLIC_META_PIXEL_ID=
